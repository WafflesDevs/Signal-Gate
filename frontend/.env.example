VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# API origin for browser fetches.
# - Local + single-service Render (API serves SPA): leave empty (same-origin).
# - Split Static Site + Web Service: set to your API URL, e.g.
#   https://signal-gate-api.onrender.com
# VITE_API_URL is accepted as an alias.
VITE_API_BASE=
# VITE_API_URL=
