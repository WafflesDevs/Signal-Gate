# Frontend (Vite) — copied into the SPA at *build* time, not read at runtime.
# Local: cp .env.example .env then fill in values.
# Render: set these in Dashboard → Environment BEFORE building, then
#   Manual Deploy → Clear build cache & deploy (required after changing VITE_*).

# Same values as root SUPABASE_URL / SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Leave empty for same-origin (local Vite proxy or single Render Web Service).
# Only set for split Static Site + API deploy.
# VITE_API_BASE=https://your-api.onrender.com
