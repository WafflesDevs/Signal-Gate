# OpenAI / research
OPENAI_API_KEY=your_openai_key
TAVILY_API_KEY=your_tavily_key

# Encrypt per-user Alpaca secrets at rest (required for Settings linking).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=your_fernet_key_here

# LangSmith — https://smith.langchain.com (optional, for agent traces)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=Signal Gate
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=Signal Gate

# Supabase (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional — only needed if you switch to local JWT verification
# SUPABASE_JWT_SECRET=your_jwt_secret

# Frontend Vite vars (REQUIRED on Render at *build* time — same values as above).
# Vite embeds VITE_* into the SPA during `npm run build`; runtime-only env is not enough.
# Also put these in frontend/.env for local `npm run dev` (see frontend/.env.example).
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key


# CORS — needed when the UI is on a different origin than the API
# (split Static Site + Web Service). Single-service same-origin can omit these.
# Comma-separated list also works via CORS_ORIGINS.
# FRONTEND_URL=https://your-app.onrender.com
# CORS_ORIGINS=https://your-app.onrender.com,https://www.your-custom-domain.com

# NOTE: Do NOT put ALPACA_API_KEY / ALPACA_SECRET_KEY here for trading.
# Users link Paper or Live keys in the Settings UI; they are stored encrypted
# per user. Project .env Alpaca keys are unused by the trading stack.
